#!/usr/bin/env bash

# basics
alias python=python3
alias pip=pip3

# BSD doesn't have --color
if $(ls --color >/dev/null 2>&1); then
  alias ls="ls --color"
else
  export CLICOLOR=1
fi

# vim
#alias vi=nvim
#alias vim=nvim
#alias vimdiff='nvim -d'

# Detect common AI coding harnesses:
set_agent_env_variable() {
  [ -n "${ANTIGRAVITY_AGENT:-}" ] && export AGENT="antigravity"
  [ -n "${CODEX_THREAD_ID:-}" ] && export AGENT="codex"
  [ -n "${CLAUDECODE:-}" ] && export AGENT="claude"
  [ -n "${OPENCODE:-}" ] && export AGENT="opencode"
  [ -n "${GROK_AGENT:-}" ] && export AGENT="grok"
  [ -n "${CURSOR_AGENT:-}" ] && export AGENT="cursor"
  [ -n "${DSH_SHELL:-}" ] && export AGENT="deepseek"
}
set_agent_env_variable

is_agent_harness() {
  [ -n "${AGENT:-}" ]
}

# Print an agent hint ($2) once per Claude Code session, tracked by an empty
# marker file per hint name ($1). Other harnesses still see it on every call.
agent_hint() {
  [[ -n "${AGENT_SILENCE_HINTS:-}" ]] && return 0
  if [[ -n "${CLAUDE_CODE_SESSION_ID:-}" ]]; then
    local marker="${TMPDIR:-/tmp}/agent-hints/$CLAUDE_CODE_SESSION_ID/$1"
    [[ -e "$marker" ]] && return 0
    # `command` skips the verbose mkdir alias; a sandbox that blocks TMPDIR just falls back to printing every time.
    command mkdir -p "${marker%/*}" 2>/dev/null && : > "$marker"
  fi
  printf '%s Silence this message (and the other user notes, but not command output) by setting `AGENT_SILENCE_HINTS=1`.\n' "$2" 1>&2
}

if is_agent_harness && [ -z "${AGENT_SILENCE_HINTS:-}" ]; then
  grep() {
    agent_hint grep 'user note: `grep` is okay if necessary, but prefer `rg` or `fff` by default.'
    command grep "$@"
  }

  find() {
    agent_hint find 'user note: `find` is okay if necessary, but prefer `fd` or `fff` by default.'
    command find "$@"
  }

  chrome-devtools() {
    agent_hint chrome-devtools 'user note: see `findrepo chrome-devtools` for help.'
    command chrome-devtools "$@"
  }

  nvim() {
    if ! type nvim >/dev/null 2>&1; then
      return 127
    fi
    agent_hint nvim 'user note: the nvim source code is available at `findrepo neovim`.'
    command nvim "$@"
  }

  lark-cli() {
    if ! type lark-cli >/dev/null 2>&1; then
      return 127
    fi
    agent_hint lark-cli 'user note: the lark-cli source code is available at `findrepo lark-cli`.'
    command lark-cli "$@"
  }

  bytedcli() {
    if ! type bytedcli >/dev/null 2>&1; then
      return 127
    fi
    agent_hint bytedcli 'user note: the bytedcli source code is available at `findrepo bytedcli`.'
    if [[ $1 == "lark" ]]; then
      agent_hint bytedcli-lark 'user note: `bytedcli lark` is a wrapper around `findrepo larksuite/cli`.'
    fi
    command bytedcli "$@"
  }

  adb() {
    if ! type adb >/dev/null 2>&1; then
      return 127
    fi
    agent_hint adb 'user note: the adb source code is available at `~/code/googlesource.com/android/platform/packages/modules/adb`.'
    command adb "$@"
  }

  cmux() {
	if ! type cmux >/dev/null 2>&1; then
      return 127
    fi
    agent_hint cmux 'user note: the cmux source code is available at `findrepo cmux`.'
    command cmux "$@"
  }

  zsh() {
	if ! type zsh >/dev/null 2>&1; then
      return 127
    fi
    agent_hint zsh 'user note: the zsh source code is available at `findrepo zsh`.'
    command zsh "$@"
  }
fi

# Grok sets GROK_AGENT=1 before zsh reads startup files, then parses
# `grep() { ... }` in that same `zsh -c` script. zsh expands this alias
# at parse time, before `unalias` can run, and every command dies with
# "defining function based on alias `grep'".
# Also skip `--color=always` in other agent harnesses so piped/captured output stays clean.
if ! is_agent_harness; then
  alias grep="egrep --color=always"
fi
alias rgv="rg --vimgrep --color=auto"
alias rgt="rg --glob '!*.spec.ts' --glob '!*mx*' --glob '!*mock*'"

#verbose
alias ln="ln -v"
alias mkdir="mkdir -pv"

# careful
# Agent harnesses often run without an interactive TTY or human at the prompt, so -i hangs them.
if ! is_agent_harness; then
	alias rm="rm -i"
	alias mv="mv -i"
	alias cp="cp -i"
fi

#git
if type git > /dev/null; then
  function git() {
    is_agent_harness && agent_hint git 'user note: The git source is available for reference at `~/code/github.com/git/git/`. Prefer sapling (`sl`) over git by default.'
    if [[ "$PWD" =~ "code.byted.or" ]]; then
      command git -c 'user.name=Max 🕺 Coplan' -c 'user.email=max.coplan@bytedance.com' "$@"
    else
      command git "$@"
    fi
  }

  alias g.="git add -p ."
  alias ga="git add"
  alias gc="git commit"
  alias gcw="git cw"
  alias gfr="git fr"
  alias gfru="git fru"
  alias glo="git -c color.ui=always log --graph --decorate=full --oneline"
  alias glog="git log --graph --decorate=full"
  alias gp="git push"
  alias gr="git rebase"
  alias gres="git restore"
  alias gs="git s"
  alias gsf="git sf"
  alias gst="git status"
  alias gstu="git status -uno"
  alias gsw="git switch"
  gsfz() {
    git switch $(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/ | fzf --height=70% --preview-window=right:60%:wrap --preview='git log --color=always --oneline --decorate {}')
  }
fi

if type gh >/dev/null 2>&1 && is_agent_harness && [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
  function gh() {
    agent_hint gh 'user note: The GitHub CLI source is available for reference at `findrepo github/cli`.'
    command gh "$@"
  }
fi

#sapling

if type sl >/dev/null 2>&1; then
  function sl() {
    local -a extra_args=()
    if is_agent_harness; then
      agent_hint sl 'user note: if you need extra help, run the sapling skill and see `findrepo sapling`.'
      extra_args+=(--pager=never)
    fi
    if [[ "$PWD" == *code.byted.or* ]]; then
      extra_args+=(--config 'ui.username=Max 🕺 Coplan <max.coplan@bytedance.com>')
    fi
    command sl "${extra_args[@]}" "$@"
  }

  alias sst="sl status && sl ssl"

  alias slc="sl commit --verbose"
  alias slci="slc --interactive"
  alias sla="sl amend"
  alias slai="sl amend --interactive"

  alias slr="sl rebase"
fi

#vscode
if ! type code >/dev/null 2>&1 && type code-insiders >/dev/null 2>&1; then
  alias code="code-insiders"
fi
if ! type trae >/dev/null 2>&1 && type trae-cn >/dev/null 2>&1;then
  alias trae="trae-cn"
fi
alias traex-frontier="traex --profile frontier"
alias agy="agy --dangerously-skip-permissions --remote-control"
if [[ -n "${ZSH_VERSION:-}" && -n "${CMUX_SHELL_INTEGRATION_DIR:-}" ]]; then
  _restore_agy_alias() {
    alias agy="agy --dangerously-skip-permissions --remote-control"
    add-zsh-hook -d precmd _restore_agy_alias
  }
  autoload -Uz add-zsh-hook
  add-zsh-hook precmd _restore_agy_alias
fi

# k8s
if type kubectl >/dev/null 2>&1; then
  alias k="kubectl"
  alias kns="kubens ce-smartlists-gql"
  alias kn="kubens"
  alias kpods="k get pods -o wide --sort-by=.metadata.creationTimestamp"
  alias kwpod="k get pod -w -o wide --sort-by=.metadata.creationTimestamp"
  alias kevents="k get events -w --sort-by=.metadata.creationTimestamp"
  alias khpa="k get hpa"
  alias kdp="k describe pod"
  alias kdhpa="k describe hpa"
  if type sledge > /dev/null; then
    #alias sl="sledge"
    #alias slc="sledge connect"
    alias slprod_w="sledge connect wus-prod-a31 && kns"
    alias slprod_s="sledge connect scus-prod-a29 && kns"
    alias slprod_e="sledge connect eus2-prod-a18 && kns"
  fi
fi
