#!/usr/bin/env bash

# basics
alias python=python3
alias pip=pip3

# BSD doesn't have --color
if $(ls --color >/dev/null 2>&1); then
  alias ls="ls --color"
else
  export CLICOLOR=1
fi

# vim
#alias vi=nvim
#alias vim=nvim
#alias vimdiff='nvim -d'

# Detect common AI coding harnesses:
set_agent_env_variable() {
  [ -n "${ANTIGRAVITY_AGENT:-}" ] && export AGENT="antigravity"
  [ -n "${CODEX_THREAD_ID:-}" ] && export AGENT="codex"
  [ -n "${CLAUDECODE:-}" ] && export AGENT="claude"
  [ -n "${OPENCODE:-}" ] && export AGENT="opencode"
  [ -n "${GROK_AGENT:-}" ] && export AGENT="grok"
  [ -n "${CURSOR_AGENT:-}" ] && export AGENT="cursor"
  [ -n "${DSH_SHELL:-}" ] && export AGENT="deepseek"
}
set_agent_env_variable

is_agent_harness() {
  [ -n "${AGENT:-}" ]
}

if is_agent_harness && [ -z "${AGENT_SILENCE_HINTS:-}" ]; then
  grep() {
    if [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: `grep` is okay if necessary, but prefer `rg` or `fff` by default. Silence by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    command grep "$@"
  }

  find() {
    if [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: `find` is okay if necessary, but prefer `fd` or `fff` by default. Silence by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    command find "$@"
  }

  chrome-devtools() {
    if [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: see `findrepo chrome-devtools` for help. Silence by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    command chrome-devtools "$@"
  }

  nvim() {
    if ! type nvim >/dev/null 2>&1; then
      return 127
    fi
    if [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: the nvim source code is available at `findrepo neovim`. Silence by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    command nvim "$@"
  }

  lark-cli() {
    if ! type lark-cli >/dev/null 2>&1; then
      return 127
    fi
    if [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: the lark-cli source code is available at `findrepo lark-cli`. Silence by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    command lark-cli "$@"
  }

  bytedcli() {
    if ! type bytedcli >/dev/null 2>&1; then
      return 127
    fi
    if [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: the bytedcli source code is available at `findrepo bytedcli`. Silence by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    command bytedcli "$@"
  }

  adb() {
    if ! type adb >/dev/null 2>&1; then
      return 127
    fi
    if [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: the adb source code is available at `~/code/googlesource.com/android/platform/packages/modules/adb`. Silence by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    command adb "$@"
  }
fi

# Grok sets GROK_AGENT=1 before zsh reads startup files, then parses
# `grep() { ... }` in that same `zsh -c` script. zsh expands this alias
# at parse time, before `unalias` can run, and every command dies with
# "defining function based on alias `grep'".
# Also skip `--color=always` in other agent harnesses so piped/captured output stays clean.
if ! is_agent_harness; then
  alias grep="egrep --color=always"
fi
alias rgv="rg --vimgrep --color=auto"
alias rgt="rg --glob '!*.spec.ts' --glob '!*mx*' --glob '!*mock*'"

#verbose
alias ln="ln -v"
alias mkdir="mkdir -pv"

# careful
# Agent harnesses often run without an interactive TTY or human at the prompt, so -i hangs them.
if ! is_agent_harness; then
	alias rm="rm -i"
	alias mv="mv -i"
	alias cp="cp -i"
fi

#git
if type git > /dev/null; then
  function git() {
    if is_agent_harness && [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: The git source is available for reference at `findrepo git/git`. Prefer sapling (`sl`) over git by default. Silence this message by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    if [[ "$PWD" =~ "code.byted.or" ]]; then
      command git -c 'user.name=Max 🕺 Coplan' -c 'user.email=max.coplan@bytedance.com' "$@"
    else
      command git "$@"
    fi
  }

  alias g.="git add -p ."
  alias ga="git add"
  alias gc="git commit"
  alias gcw="git cw"
  alias gfr="git fr"
  alias gfru="git fru"
  alias glo="git -c color.ui=always log --graph --decorate=full --oneline"
  alias glog="git log --graph --decorate=full"
  alias gp="git push"
  alias gr="git rebase"
  alias gres="git restore"
  alias gs="git s"
  alias gsf="git sf"
  alias gst="git status"
  alias gstu="git status -uno"
  alias gsw="git switch"
  gsfz() {
    git switch $(git for-each-ref --sort=-committerdate --format='%(refname:short)' refs/ | fzf --height=70% --preview-window=right:60%:wrap --preview='git log --color=always --oneline --decorate {}')
  }
fi

if type gh >/dev/null 2>&1 && is_agent_harness && [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
  function gh() {
    echo 'user note: The GitHub CLI source is available for reference at `findrepo github/cli`. Silence this message by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    command gh "$@"
  }
fi

#sapling

if type sl >/dev/null 2>&1; then
  function sl() {
    if is_agent_harness && [[ -z "${AGENT_SILENCE_HINTS:-}" ]]; then
      echo 'user note: if you need extra help, run the sapling skill and see `findrepo sapling`. Silence this message by setting `AGENT_SILENCE_HINTS=1`' 1>&2
    fi
    if [[ "$PWD" =~ "code.byted.or" ]]; then
      command sl --config 'ui.username=Max 🕺 Coplan <max.coplan@bytedance.com>' $@
    else
      command sl $@
    fi
  }

  alias sst="sl status && sl ssl"

  alias slc="sl commit --verbose"
  alias slci="slc --interactive"
  alias sla="sl amend"
  alias slai="sl amend --interactive"

  alias slr="sl rebase"
fi

#vscode
if ! type code >/dev/null 2>&1 && type code-insiders >/dev/null 2>&1; then
  alias code="code-insiders"
fi
if ! type trae >/dev/null 2>&1 && type trae-cn >/dev/null 2>&1;then
  alias trae="trae-cn"
fi
alias traex-frontier="traex --profile frontier"
alias agy="agy --dangerously-skip-permissions --remote-control"

# k8s
if type kubectl >/dev/null 2>&1; then
  alias k="kubectl"
  alias kns="kubens ce-smartlists-gql"
  alias kn="kubens"
  alias kpods="k get pods -o wide --sort-by=.metadata.creationTimestamp"
  alias kwpod="k get pod -w -o wide --sort-by=.metadata.creationTimestamp"
  alias kevents="k get events -w --sort-by=.metadata.creationTimestamp"
  alias khpa="k get hpa"
  alias kdp="k describe pod"
  alias kdhpa="k describe hpa"
  if type sledge > /dev/null; then
    #alias sl="sledge"
    #alias slc="sledge connect"
    alias slprod_w="sledge connect wus-prod-a31 && kns"
    alias slprod_s="sledge connect scus-prod-a29 && kns"
    alias slprod_e="sledge connect eus2-prod-a18 && kns"
  fi
fi
