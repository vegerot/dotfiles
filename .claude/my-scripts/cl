#!/usr/bin/env bun
// cl — one Claude Code Remote Control server per repo, one tmux window each.
//
//   cl <repo>        jump to (or start) the server for a repo already cloned
//   cl <git-url>     clone into ~/code/<host>/<org>/<repo>, then start
//   cl clone <url>   clone only
//   cl reindex       rebuild the repo index
//   cl update        update claude, then restart every server on the new binary
//
// See README.md next to this script.
import { existsSync, mkdirSync, readFileSync, writeFileSync } from "node:fs"
import { homedir } from "node:os"
import { basename, dirname } from "node:path"

const USAGE = "usage: cl <repo-name|git-url> | cl clone <url> | cl reindex | cl update"
const CL_ROOT = `${homedir()}/code`
const CL_INDEX = `${homedir()}/.cache/cl-repos`
const CLAUDE = `${homedir()}/.local/bin/claude`

const die = (message: string): never => {
  console.error(`cl: ${message}`)
  process.exit(1)
}

// Run a command on the terminal. A failure ends cl with the command's exit code.
const run = (...argv: string[]) => {
  const { exitCode } = Bun.spawnSync(argv, { stdin: "inherit", stdout: "inherit", stderr: "inherit" })
  if (exitCode !== 0) process.exit(exitCode)
}

// Run a command quietly and return its output, or null when it fails.
const capture = (...argv: string[]) => {
  const { exitCode, stdout } = Bun.spawnSync(argv, { stderr: "ignore" })
  return exitCode === 0 ? stdout.toString().trimEnd() : null
}

const tmux = (...args: string[]) => run("tmux", ...args)
const tmuxQuery = (...args: string[]) => capture("tmux", ...args)

const reindex = () => {
  const found = capture("fd", "--hidden", "--no-ignore", "--max-depth=4", "--type=directory", "^\\.git$", CL_ROOT) ?? ""
  const repos = found.split("\n").filter(Boolean).map((gitDir) => gitDir.replace(/\/\.git\/$/, "")).sort()
  mkdirSync(dirname(CL_INDEX), { recursive: true })
  writeFileSync(CL_INDEX, repos.map((repo) => repo + "\n").join(""))
  console.error(`cl: indexed ${repos.length} repos`)
  return repos
}

// Turn a git URL into ~/code/<host>/<org>/<repo> and clone it there.
const clone = (url: string) => {
  const path = url
    .replace(/^.*?:\/\//, "") // https://
    .replace(/^.*?@/, "") // git@
    .replace(":", "/") // github.com:org/repo
    .replace(/\.git$/, "")
    .replace(/\/$/, "")
  const dir = `${CL_ROOT}/${path}`
  if (!existsSync(`${dir}/.git`)) {
    run("git", "clone", url, dir)
    reindex()
  }
  return dir
}

// The path of a cloned repo, by its directory name.
const findRepo = (repo: string) => {
  const indexed = existsSync(CL_INDEX) ? readFileSync(CL_INDEX, "utf8").split("\n").filter(Boolean) : []
  const named = (dir: string) => basename(dir) === repo
  return indexed.find(named) ?? reindex().find(named)
}

const serverCommand = (repo: string) =>
  `CLAUDE_CODE_ENABLE_CFC=1 ${CLAUDE} remote-control --name=devbox-${repo} --spawn=worktree --permission-mode=bypassPermissions --chrome`

// A running server keeps the claude binary it started with, and so does every
// chat it spawns.  Update the binary, then restart the servers onto it.  This
// interrupts the chats.  It does not lose them: their transcripts live on
// Anthropic's servers.
const update = () => {
  run(CLAUDE, "update")
  // `-f` keeps the servers and drops the plain shell windows.
  const servers = tmuxQuery("list-windows", "-t", "cl", "-f", "#{@cl_repo}", "-F", "#{window_name}\t#{@cl_repo}\t#{pane_current_path}")
  for (const server of (servers ?? "").split("\n").filter(Boolean)) {
    const [window, repo, dir] = server.split("\t")
    tmux("respawn-window", "-k", "-t", `cl:${window}`, "-c", dir, serverCommand(repo))
    console.error(`cl: restarted ${repo}`)
  }
}

const serve = (repo: string, dir: string) => {
  const window = `cl:${repo.replace(/[.:]/g, "_")}`
  const command = serverCommand(repo)

  // `=cl` is exactly the session `cl`.  A bare `cl` also matches, by prefix, a
  // window or session named `claude`, and new-window then fails with
  // "create window failed: index N in use".
  if (tmuxQuery("has-session", "-t", "=cl") === null) tmux("new-session", "-d", "-s", "cl", "-n", "home")

  if (tmuxQuery("has-session", "-t", window) === null) {
    tmux("new-window", "-t", "=cl:", "-n", window.slice("cl:".length), "-c", dir, command)
    // Keep the window (and the error output) after claude exits, so the next
    // `cl` can tell a dead server from a live one and restart it.
    tmux("set-option", "-w", "-t", window, "remain-on-exit", "on")
  } else if (tmuxQuery("display-message", "-p", "-t", window, "#{pane_dead}") === "1") {
    tmux("respawn-window", "-t", window, "-c", dir, command)
  }

  // Mark the window as a server, and with which repo.  `cl update` restarts
  // exactly these, and skips the plain shell windows in the same session.
  tmux("set-option", "-w", "-t", window, "@cl_repo", repo)

  tmux("select-window", "-t", window)
  if (!process.env.TMUX) tmux("attach", "-t", "cl")
}

const [target, url] = process.argv.slice(2)
if (!target) die(USAGE)

if (target === "reindex") {
  reindex()
} else if (target === "clone") {
  console.log(clone(url ?? die("usage: cl clone <git-url>")))
} else if (target === "update") {
  update()
} else if (target.includes("://") || /@.*:/.test(target) || target.includes("/")) {
  const dir = clone(target)
  serve(basename(dir), dir)
} else {
  serve(target, findRepo(target) ?? die(`no repo named '${target}'. Give a git URL to clone it.`))
}
