{
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null || exit 0; atuin hook claude-code",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook bits postToolUse",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null || exit 0; atuin hook claude-code",
            "timeout": 10
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook bits postToolUseFailure",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null || exit 0; atuin hook claude-code",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ],
        "matcher": "*"
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook bits preToolUse",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook bits sessionStart",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook bits stop",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook bits subagentStop",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ],
        "matcher": "*"
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "timeout": 86400
          }
        ],
        "matcher": "*"
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/my-scripts/flux-hook relay",
            "async": true
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash ~/.claude/statusline-command.sh"
  },
  "enabledPlugins": {
    "clangd-lsp@claude-plugins-official": false,
    "github@claude-plugins-official": true,
    "gopls-lsp@claude-plugins-official": false,
    "lua-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "high",
  "modelSettings": {
    "claude-fable-5": {
      "effortLevel": "xhigh"
    }
  },
  "askUserQuestionTimeout": "10m",
  "autoUpdatesChannel": "latest",
  "tui": "default",
  "skipDangerousModePermissionPrompt": true,
  "theme": "auto",
  "editorMode": "vim",
  "verbose": true,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "syntaxHighlightingDisabled": false
}
