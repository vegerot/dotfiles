{
  "env": {
    "CLAUDE_CODE_ENABLE_CFC": "1",
    "CLAUDE_CODE_AUTO_BACKGROUND_TIMEOUT_MS": "30000",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^(?!Bash$)",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/claude-slow-tool-note"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null || exit 0; atuin hook claude-code",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook bits claude-code postToolUse",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^(?!Bash$)",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/claude-slow-tool-note"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null || exit 0; atuin hook claude-code",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook bits claude-code postToolUseFailure",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "command -v atuin >/dev/null || exit 0; atuin hook claude-code",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|Bash|NotebookEdit|mcp__.*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook bits claude-code preToolUse",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/claude-recap-title apply"
          },
          {
            "type": "command",
            "command": "~/dotfiles/bin/claude-recap-title generate",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook bits claude-code sessionStart",
            "timeout": 30,
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "/bin/sh -c 'rex __internal session-start --agent claude --feature-session-naming=false 2>/dev/null || true'",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook dedupe",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/claude-friction-nudge"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook bits claude-code stop",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          },
          {
            "type": "command",
            "command": "~/.claude/my-scripts/auto-continue-on-drop",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook bits claude-code subagentStop",
            "timeout": 30,
            "async": true
          }
        ]
      }
    ],
    "Notification": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "timeout": 86400
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "~/dotfiles/bin/flux-hook relay claude",
            "async": true
          }
        ]
      }
    ]
  },
  "// defaultShell": "Applies on Windows only. It makes input-box ! commands run `pwsh -NoProfile -Command`. On GNU+Linux and macOS Claude Code changes this back to bash, because the PowerShell tool is Windows-only. So this key is safe in shared dotfiles. JSON has no comments, but the settings schema is .passthrough(), so this key is kept and ignored.",
  "defaultShell": "powershell",
  "statusLine": {
    "type": "command",
    "command": "zsh -f ~/.claude/statusline-command.zsh"
  },
  "enabledPlugins": {
    "lua-lsp@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "swift-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "cc-plugin-you-should-know@builtin": true,
    "plugin-dev@anthropic-plugin-directory": true,
    "agent-sdk-dev@anthropic-plugin-directory": true,
    "explanatory-output-style@anthropic-plugin-directory": true,
    "frontend-design@anthropic-plugin-directory": true
  },
  "askUserQuestionTimeout": "10m",
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "cleanupPeriodDays": 3650,
  "showMessageTimestamps": true,
  "showThinkingSummaries": true,
  "dialogExpiry": "10m",
  "autoDreamEnabled": true,
  "spinnerVerbs": {
    "mode": "append",
    "verbs": [
      "Yak-shaving",
      "Bikeshedding",
      "Reticulating splines",
      "Rubber-ducking",
      "Blaming DNS",
      "Reading the source",
      "Exiting vim",
      "Rebasing onto regret",
      "Untangling symlinks",
      "Asking the devbox nicely",
      "Dodging earlyoom",
      "Grepping the void",
      "Deleting backwards compatibility",
      "Not being paranoid",
      "Running a small experiment",
      "Wavedashing",
      "Consulting the changelog",
      "Counting tokens",
      "Feeding the hooks",
      "Turning it off and on again"
    ]
  },
  "voice": {
    "enabled": true
  }
}
