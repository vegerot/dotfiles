{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 86400,
            "type": "command"
          }
        ],
        "matcher": "*"
      },
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks feed --source codex --event PermissionRequest",
            "timeout": 5,
            "type": "command",
            "async": false
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks feed --source codex --event PostCompact",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "command -v atuin >/dev/null || exit 0; atuin hook codex",
            "commandWindows": "pwsh -NoProfile -Command \"& (Join-Path ~ '.codex/hooks/atuin-codex.ps1')\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook bits codex postToolUse",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks feed --source codex --event PostToolUse",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks feed --source codex --event PreCompact",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "command -v atuin >/dev/null || exit 0; atuin hook codex",
            "commandWindows": "pwsh -NoProfile -Command \"& (Join-Path ~ '.codex/hooks/atuin-codex.ps1')\"",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook bits codex preToolUse",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 30,
            "type": "command"
          }
        ],
        "matcher": ".*"
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.codex/hooks/context-reminder.py",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks feed --source codex --event PreToolUse",
            "timeout": 5,
            "type": "command",
            "async": false
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook bits codex sessionStart",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks codex session-start",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook bits codex stop",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/.codex/hooks/model-switch-reminder.py",
            "commandWindows": "pwsh -NoProfile -Command \"py -3 (Join-Path ~ '.codex/hooks/model-switch-reminder.py')\"",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks codex stop",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks feed --source codex --event SubagentStart",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook bits codex subagentStop",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks feed --source codex --event SubagentStop",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "async": true,
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "commandWindows": "pwsh -NoProfile -Command \"exit 0\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/.codex/hooks/cmux hooks codex prompt-submit",
            "timeout": 5,
            "type": "command",
            "async": true
          }
        ]
      }
    ]
  }
}
