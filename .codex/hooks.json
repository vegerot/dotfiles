{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "type": "command",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook bits codex postToolUse",
            "type": "command",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "atuin hook codex",
            "type": "command"
          }
        ],
        "matcher": "^Bash$"
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "type": "command",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": ".*",
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook bits codex preToolUse",
            "type": "command",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "type": "command",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook bits codex sessionStart",
            "type": "command",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "type": "command",
            "timeout": 5
          }
        ]
      }
    ],
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "type": "command",
            "timeout": 86400
          }
        ],
        "matcher": "*"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "type": "command",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook bits codex stop",
            "type": "command",
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook relay codex",
            "type": "command",
            "timeout": 5
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "~/dotfiles/bin/flux-hook bits codex subagentStop",
            "type": "command",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
