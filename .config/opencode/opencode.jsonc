{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "~/dotfiles/.config/opencode/introspection.md"
  ],
  "plugin": [
    "./plugin/conditional-bytedance.ts",
    ".\/plugins\/cmux-session.js",
    "file:///Users/bytedance/.config/opencode/plugins/flux-opencode-plugin.js"
  ],
  "lsp": true,
  "mcp": {
    "mdn": {
      "type": "remote",
      "url": "https://mcp.mdn.mozilla.net/"
    },
    "atuin": {
      "type": "local",
      "command": [
        "atuin",
        "mcp",
      ],
      "enabled": true
    },
    "fff": {
      "type": "local",
      "command": [
        "fff-mcp"
      ],
      "enabled": true
    },
    "robinhood-trading": {
      "type": "remote",
      "url": "https://agent.robinhood.com/mcp/trading",
      "enabled": false,
    },
    "Chrome DevTools": {
      "type": "local",
      "command": [
        "bunx",
        "chrome-devtools-mcp",
        "--channel=dev"
      ]
    },
    "openrouter": {
      "type": "remote",
      "url": "https://mcp.openrouter.ai/mcp",
      "enabled": false
    },
    "Trae_CLI": {
     "type": "local",
     "command": [
       "traecli",
       "mcp",
       "serve"
     ],
      "enabled": false,
    },
  },
  "permissions": [
    {
      "action": "*",
      "resource": "*",
      "effect": "allow"
    }
  ],

  "provider": {
    "better_pareto_router": {
      "name": "Frontier Router",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "baseURL": "http://localhost:4000/v1"
      },
      "models": {
        "pareto": {
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Frontier Router",
          "variants": {
            "💩": {
              "headers": {
                "X-Pareto-P": "0"
              },
              "reasoning": { "effort": "none" },
            },
            "low": {
              "headers": {
                "X-Pareto-P": "0.6"
              },
              "reasoning": { "effort": "low" },
            },
            "medium": {
              "headers": {
                "X-Pareto-P": "0.8"
              }
            },
            "high": {
              "headers": {
                "X-Pareto-P": "0.9"
              }
            },
            "🤩": {
              "headers": {
                "X-Pareto-P": "1"
              },
              "reasoning": { "effort": "xhigh" },
            },
          }
        },
        "throughput": {
          "modalities": {
            "input": [
              "text",
              "image"
            ],
            "output": [
              "text"
            ]
          },
          "name": "Frontier Router(fast)",
          "variants": {
            "💩": {
              "headers": {
                "X-Pareto-P": "0"
              },
              "reasoning": { "effort": "none" },
            },
            "low": {
              "headers": {
                "X-Pareto-P": "0.6"
              },
              "reasoning": { "effort": "low" },
            },
            "medium": {
              "headers": {
                "X-Pareto-P": "0.8"
              }
            },
            "high": {
              "headers": {
                "X-Pareto-P": "0.9"
              }
            },
            "🤩": {
              "headers": {
                "X-Pareto-P": "1"
              },
              "reasoning": { "effort": "xhigh" },
            },
          }
        }
      },
    },
    "openrouter": {
      "models": {
        "openrouter/pareto-code": {
          "variants": {
            "💩": {
              "plugins": [
                { "id": "pareto-router", "min_coding_score": 0.0 }
              ],
              "reasoning": { "effort": "none" },
              "limit": {
                "context": 100000
              }
            },
            "low": {
              "plugins": [
                { "id": "pareto-router", "min_coding_score": 0.1 }
              ],
            },
            "medium": {
              "plugins": [
                { "id": "pareto-router", "min_coding_score": 0.34 }
              ]
            },
            "high": {
              "plugins": [
                { "id": "pareto-router", "min_coding_score": 0.67 }
              ],
            },
            "🤩": {
              "plugins": [
                { "id": "pareto-router", "min_coding_score": 1 }
              ],
              "reasoning": { "effort": "xhigh" },
              "limit": {
                "context": 1048576
              }
            }
          }
        }
      }
    },
    "my_ark": {
      "name": "My Ark",
      "options": {
        "baseURL": "https://ark-cn-beijing.bytedance.net/api/v3",
        "apiKey": "{env:BYTED_ARK_API_KEY}"
