<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.vegerot.trae-openai-proxy</string>
	<key>ProgramArguments</key>
	<array>
		<string>/Users/bytedance/.bun/bin/bun</string>
		<string>/Users/bytedance/.config/opencode/plugins/trae/server.ts</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
