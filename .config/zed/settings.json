// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
	"disable_ai": false,
 "proxy": "",
	"edit_predictions": {
		"provider": "mercury",
	},
	"tabs": {
		"show_diagnostics": "errors",
		"file_icons": false,
		"git_status": true,
	},
	"title_bar": {
		"show_menus": false,
		"show_branch_status_icon": false,
	},
	"status_bar": {
		"show_active_file": true,
	},
	"search": {
		"center_on_match": true,
	},
	"use_smartcase_search": true,
	"diagnostics": {
		"inline": {
			"enabled": true,
		},
	},
	"document_symbols": "on",
	"document_folding_ranges": "on",
	"semantic_tokens": "combined",
	"colorize_brackets": true,
	"code_lens": "on",
	"inlay_hints": {
		"show_background": true,
		"enabled": true,
	},
	"indent_guides": {
		"coloring": "indent_aware",
		"background_coloring": "disabled",
	},
	"preferred_line_length": 100,
	"hard_tabs": true,
	"toolbar": {
		"code_actions": true,
	},
	"show_signature_help_after_edits": true,
	"auto_signature_help": true,
	"autoscroll_on_clicks": true,
	"sticky_scroll": {
		"enabled": true,
	},
	"which_key": {
		"enabled": true,
	},
	"telemetry": {
		"diagnostics": true,
		"metrics": true,
		"anthropic_retention": true,
	},
	"agent": {
		"expand_terminal_card": false,
  "play_sound_when_agent_done": "when_hidden",
  "sandbox_permissions": {
   "allow_unsandboxed": true
  },
  "auto_compact": {
			"threshold": "90%",
		},
		"show_turn_stats": true,
		"tool_permissions": {
			"default": "allow",
   "tools": {
				"terminal": {
					"default": "allow",
     "always_deny": [
						{
							"pattern": "^cat\\s+internal/proxy/server\\.go(\\s|$)",
						},
					],
					"always_allow": [
      {
       "pattern": "^rg\\b"
      },
      {
       "pattern": "^head\\b"
      },
      {
       "pattern": "^make\\s+test(\\s|$)"
      },
      {
       "pattern": "^git\\s+status(\\s|$)"
      },
      {
       "pattern": "^fd\\b"
      },
      {
       "pattern": "^cat\\b"
      },
      {
       "pattern": "^ls\\b"
      },
      {
       "pattern": "^sed\\b"
      },
      {
       "pattern": "^cd\\s+\\~/code/github\\.com/openai/codex/(\\s|$)"
      },
      {
       "pattern": "^gh\\s+issue\\s+view(\\s|$)"
      },
      {
       "pattern": "^gh\\s+issue\\s+list(\\s|$)"
      },
      {
       "pattern": "^sqlite3\\s+\\~/\\.local/share/opencode/opencode-\\.db(\\s|$)"
      },
      {
       "pattern": "^sqlite3\\s+\\~/\\.local/share/opencode/opencode-local\\.db(\\s|$)"
      },
      {
       "pattern": "^wc\\b"
      },
      {
       "pattern": "^cat\\s+/Users/bytedance/\\.config/zed/settings\\.json(\\s|$)"
      },
      {
       "pattern": "^grep\\b"
      }
     ],
				},
			},
		},
		"default_model": {
			"provider": "CLIProxy",
			"model": "gemini-3.8-flash-high",
			"enable_thinking": false,
		},
		"favorite_models": [
   {
    "provider": "Better Coding Router",
    "model": "pareto@0.6",
    "enable_thinking": true
   },
   {
    "provider": "Better Coding Router",
    "model": "pareto@0.8",
    "enable_thinking": true
   },
   {
    "provider": "Better Coding Router",
    "model": "pareto@0.9",
    "enable_thinking": true
   },
   {
    "provider": "CLIProxy",
    "model": "gemini-3.8-flash-high",
    "enable_thinking": false
   },
   {
    "provider": "CLIProxy",
    "model": "claude-sonnet-5-5-high",
    "enable_thinking": false
   },
   {
    "provider": "CLIProxy",
    "model": "claude-opus-5-5-high",
    "enable_thinking": false
   }
  ],
		"model_parameters": [],
	},
	"language_models": {
