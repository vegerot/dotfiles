	},
	"cli_default_open_behavior": "existing_window",
	"session": {
		"trust_all_worktrees": true,
	},
	"vim_mode": true,
	"terminal": {
		"max_scroll_history_lines": 10000000000,
	},
	"git": {
		"inline_blame": {
			"enabled": false,
		},
	},
	"base_keymap": "VSCode",
	"minimap": {
		"show": "always",
	},
	"use_system_window_tabs": true,
	"autosave": "on_focus_change",
	"buffer_font_fallbacks": [
		"SFMono Nerd Font",
		"JetBrainsMono Nerd Font",
		"JetBrains Mono",
		"Menlo",
		"Monaco",
		"Courier New",
		"monospace",
	],
	"buffer_font_family": "SFMono Nerd Font",
	"linked_edits": true,
	"agent_servers": {
		"antigravity-acp": {
   "type": "registry"
  },
  "traecli": {
			"type": "custom",
			"command": "traecli",
			"args": ["acp", "serve"]
		},

		"opencode": {
			"type": "custom",
			"command": "opencode",
			"args": ["acp"],
		},
		"github-copilot-cli": {
			"type": "custom",
			"command": "copilot",
			"args": ["--acp"],
		},
		"codex-acp": {
			"type": "registry",
		},
		"claude-acp": {
			"type": "registry",
		},
	},
	"ui_font_size": 16,
	"buffer_font_size": 14.0,
	"theme": {
		"mode": "system",
		"light": "One Light",
		"dark": "One Dark",
	},
}
