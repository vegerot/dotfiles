{
  "mcpServers": {
    "cmux-cua": {
      "command": "/Applications/cmux.app/Contents/Resources/bin/cmux-cua",
      "args": [
        "mcp"
      ]
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--auto-connect",
        "--channel=dev"
      ]
    },
    "fff": {
      "command": "fff-mcp",
      "args": [],
      "disabled": false
    }
  }
}
