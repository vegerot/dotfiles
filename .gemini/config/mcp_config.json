{
  "mcpServers": {
    "cua-driver": {
      "command": "cua-driver",
      "args": [
        "mcp"
      ]
    },
    "chrome-devtools": {
      "command": "bunx",
      "args": [
        "chrome-devtools-mcp@latest",
        "--auto-connect",
        "--channel=dev",
        "--categoryExtensions=true",
        "--experimentalVision=true",
        "--memoryDebugging=true",
        "--categoryThirdParty=true"
      ]
    },
    "fff": {
      "command": "fff-mcp",
      "args": [],
      "disabled": false
    },
    "atuin": {
      "command": "atuin",
      "args": [
        "mcp"
      ]
    },
    "dayflow": {
      "command": "start-mcp-else-empty",
      "args": [
        "dayflow",
        "mcp"
      ]
    }
  }
}
