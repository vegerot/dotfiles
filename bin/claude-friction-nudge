#!/usr/bin/env bun
// Claude Code Stop hook: when this turn shows friction signals and the final
// reply has no 🔧 Friction section, ask Claude once to consider adding one,
// with the counts as evidence. It reads only the current turn: the transcript
// lines after the last turn_duration marker.
import { readFile } from "node:fs/promises"

type StopInput = {
  stop_hook_active?: boolean
  last_assistant_message?: string
  transcript_path: string
}
type Block = { type?: string; is_error?: boolean; content?: unknown }
type Entry = {
  type?: string
  message?: { content?: Block[] | string }
  attachment?: { type?: string; content?: unknown[] }
}

const input: StopInput = await Bun.stdin.json()
// Already nudged this turn, or the reply already reports friction.
if (input.stop_hook_active || input.last_assistant_message?.includes("🔧 Friction")) process.exit(0)

const transcript = await readFile(input.transcript_path, "utf8").catch(() => process.exit(0))
const marker = transcript.lastIndexOf('"subtype":"turn_duration"')
const turnStart = marker < 0 ? 0 : transcript.indexOf("\n", marker) + 1
const turn: Entry[] = transcript.slice(turnStart).split("\n").filter(Boolean).map((line) => JSON.parse(line))

const blocks = (role: string, blockType: string) =>
  turn
    .filter((entry) => entry.type === role)
    .flatMap((entry) => (Array.isArray(entry.message?.content) ? entry.message.content : []))
    .filter((block) => block.type === blockType)

const calls = blocks("assistant", "tool_use").length
const results = blocks("user", "tool_result")
const failed = results.filter((result) => result.is_error === true).length
// ⏱ notes come from two places: the Bash EXIT trap in ~/.zshenv (inside the
// tool result) and the claude-slow-tool-note hook (a transcript attachment).
const slowBash = results.filter((result) => JSON.stringify(result.content).includes("⏱ Bash took")).length
const slowOther = turn
  .filter((entry) => entry.attachment?.type === "hook_additional_context")
  .flatMap((entry) => entry.attachment?.content ?? [])
  .filter((note) => typeof note === "string" && note.startsWith("⏱ ")).length
const slow = slowBash + slowOther

if (calls >= 40 || failed >= 3 || slow >= 3) {
  console.log(JSON.stringify({
    hookSpecificOutput: {
      hookEventName: "Stop",
      additionalContext: `Friction check for this turn: ${calls} tool calls, ${failed} failed, ${slow} took 10 s or more (⏱). If any of that came from friction worth reporting, add a short 🔧 Friction section now, as the global instructions describe. If not, stop without adding anything.`,
    },
  }))
}
