#!/usr/bin/env bun
// Generate Claude Code's picker from the same chat catalog as Pi and OpenCode.
// `--desktop` instead points Claude Desktop's third-party (3P) gateway mode at the proxy.
import { mkdir, mkdtemp, rm, writeFile } from "node:fs/promises"
import { homedir, tmpdir } from "node:os"
import { join } from "node:path"
import { fetchCatalog, PROXY_URL, PROXY_KEY } from "../.config/cliproxy/catalog"

if (process.argv.includes("--desktop")) {
  // Fixed so reruns overwrite the same entry in Desktop's configuration library.
  const id = "c11a0de5-0000-4000-8000-c11a0de5c0de"
  const library = join(homedir(), "Library/Application Support/Claude-3p/configLibrary")
  await mkdir(library, { recursive: true, mode: 0o700 })
  const write = (name: string, value: unknown) =>
    writeFile(join(library, name), `${JSON.stringify(value, null, 2)}\n`, { mode: 0o600 })
  // Same filtered catalog as the terminal picker. Desktop only shows the Effort
  // control for IDs in its own table, so Antigravity Claude uses the proxy's
  // claude-opus-5/claude-sonnet-5 aliases, and other models the proxy's
  // claude-fable-5-dd-<reversed id> form, which Desktop's model filter accepts.
  const desktopId = (id: string) =>
    id.startsWith("claude-") ? id.replace(/^(claude-(?:opus|sonnet)-5)-5-high$/, "$1")
      : `claude-fable-5-dd-${[...id].reverse().join("")}`
  const models = [...new Map((await fetchCatalog(new AbortController().signal)).map((model) =>
    [desktopId(model.id), model])).entries()]
  if (!models.length) throw new Error("CLIProxyAPI returned no chat models")
  await write(`${id}.json`, {
    inferenceProvider: "gateway",
    // Desktop appends /v1/messages and /v1/models itself.
    inferenceGatewayBaseUrl: PROXY_URL.replace(/\/v1\/?$/, ""),
    inferenceGatewayAuthScheme: "bearer",
    inferenceCredentialKind: "static",
    inferenceGatewayApiKey: PROXY_KEY,
    // Unset means an empty allowlist, which forces a locked sandbox on Code sessions.
    coworkEgressAllowedHosts: ["*"],
    // The first entry is the default; full IDs let Desktop skip /v1/models discovery.
    inferenceModels: [...models]
      .sort(([a], [b]) => Number(b === "claude-opus-5") - Number(a === "claude-opus-5"))
      .map(([name, model]) => ({
        name,
        labelOverride: model.name.replace(/ \(High\)$/, ""),
        ...((model.context ?? 0) >= 1_000_000 && { supports1m: true, prefer1m: true }),
      })),
  })
  await write("_meta.json", { appliedId: id, entries: [{ id, name: "CLIProxyAPI", provider: "gateway" }] })
  console.log(`Wrote ${library}; quit and relaunch Claude Desktop, then choose the third-party option.`)
  process.exit()
}

const models = await fetchCatalog(new AbortController().signal)
if (!models.length) throw new Error("CLIProxyAPI returned no chat models")
const directory = await mkdtemp(join(tmpdir(), "claude-proxy-"))
const settings = join(directory, "settings.json")
await writeFile(settings, JSON.stringify({
  modelPicker: {
    replaceBuiltInOptions: true,
    options: models.map((model) => ({
      model: model.id,
      label: model.name,
      description: `${model.owner || "CLIProxyAPI"} · ${model.context ? `${Math.round(model.context / 1000)}K context` : "context unspecified"}`,
    })),
  },
  model: "claude-opus-5-5-high",
}))
try {
  const child = Bun.spawn(["claude", "--settings", settings, ...process.argv.slice(2)], {
    stdin: "inherit", stdout: "inherit", stderr: "inherit",
    env: {
      ...process.env,
      ANTHROPIC_BASE_URL: PROXY_URL.replace(/\/v1\/?$/, ""),
      ANTHROPIC_AUTH_TOKEN: PROXY_KEY,
      ...(process.argv.includes("--bare") ? { ANTHROPIC_API_KEY: PROXY_KEY } : {}),
      // The generated picker already filters media, hidden routes, and Standard duplicates.
      CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY: "0",
      CLAUDE_CODE_MAX_CONTEXT_TOKENS: "900000",
      ANTHROPIC_DEFAULT_OPUS_MODEL: "claude-opus-5-5-high",
      ANTHROPIC_DEFAULT_SONNET_MODEL: "claude-sonnet-5-5-high",
      ANTHROPIC_DEFAULT_HAIKU_MODEL: "Seed-2.1-Turbo",
    },
  })
  process.exitCode = await child.exited
} finally {
  await rm(directory, { recursive: true })
}
