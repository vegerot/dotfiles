#!/usr/bin/env bash

set -o errexit
set -o nounset
set -o pipefail

# List all repositories in the current directory

main() {
	if [[ ${1:-} == "deep" ]]; then
		shift
		fd '^\.(git|sl)$' "$@" \
			--no-ignore --max-depth=10 --hidden --type=d --follow --prune \
			--exec dirname {} \; \
			| sort
	else
		fd '^.git$' "$@" \
			--no-ignore --max-depth=5 --hidden --type=d --follow --prune \
			--exec dirname {} \; \
			| sort
	fi
}

main $@
