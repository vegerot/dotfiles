#!/usr/bin/env bash
# One Flux Island hook entry point for macOS and Linux, so the agent config
# files can be the same on both machines.
#
#   flux-hook relay <agent>          claude | gemini | codex | ...
#   flux-hook bits <agent> <event>   claude-code postToolUse, codex stop, ...
#   flux-hook agy <event>            PreToolUse | PostToolUse | PreInvocation | PostInvocation | Stop
#
# Flux Island is a macOS app. It installs Linux helpers under ~/.flux/bin on a
# dev box when you connect to that box from its Remote SSH pane. The two live
# at different paths, so pick by OS. Exit 0 without output when Flux is absent,
# so the hook never blocks the agent. Windows falls through and does nothing.
set -u

mac_app='/Applications/Flux Island.app'
mac_bin="$mac_app/Contents/MacOS/Flux Island"
linux_bin="$HOME/.flux/bin"

# Flux stamps its own version into these hooks. Update it after a Flux upgrade.
tea_env=(TEA_APP_ID=1013111 TEA_CHANNEL=cn TEA_APP_NAME_FOR_BITS=@fluxisland@0.1.45-hotfix.b7dbf23@0.4.22)

# Antigravity (agy CLI, Desktop, IDE, and Zed antigravity-acp) hook wrapper.
# Note: antigravity-acp executes hook commands via shlex.split + execve (no
# shell), so hooks.json must invoke this script directly without shell syntax.
if [ "${1:-}" = agy ]; then
	event="${2:-}"
	input=$(cat 2>/dev/null || true)
	(
		if [ -n "$input" ] && command -v jq >/dev/null 2>&1; then
			flux_event=""
			case "$event" in
			PreInvocation)
				inv_num=$(printf '%s' "$input" | jq -r '.invocationNum // 1' 2>/dev/null || echo 1)
				[ "$inv_num" = "1" ] && flux_event="BeforeAgent"
				;;
			PreToolUse) flux_event="BeforeTool" ;;
			PostToolUse) flux_event="AfterTool" ;;
			Stop) flux_event="AfterAgent" ;;
			esac
			if [ -n "$flux_event" ]; then
				printf '%s' "$input" | jq -c --arg ev "$flux_event" '
					. + {
						hook_event_name: $ev,
						session_id: (.conversationId // .session_id // "agy"),
						cwd: ((.workspacePaths[0] // .cwd // "") | sub("^file://"; "")),
						tool_name: (.toolCall.name // .tool_name // null),
						tool_input: (.toolCall.args // .tool_input // null),
						tool_response: (.toolOutput // .tool_response // null)
					}
				' 2>/dev/null | "$0" relay gemini
			fi
		fi
		if [ "$event" = "Stop" ] && [ -n "$input" ]; then
			printf '%s' "$input" | "$0" bits agy Stop
		fi
	) </dev/null >/dev/null 2>&1 &
	if [ "$event" = "PreToolUse" ]; then
		echo '{"decision":"allow"}'
	else
		echo '{}'
	fi
	exit 0
fi

# Flux re-adds its own inline Claude hooks at every launch. It recognizes its
# groups by these substrings, and the "flux-hook relay|bits" wrappers above
# contain none of them, so Flux thinks its hooks are missing. The inline copies
# duplicate the wrappers, and most of them block. An async SessionStart hook
# runs this to remove them whenever they come back. (Turning Flux's Claude
# toggle off would also stop the rewrites, but then Flux drops every Claude
# event, wrappers included.)
if [ "${1:-}" = dedupe ]; then
	settings="$HOME/.claude/settings.json"
	markers='flux-hooks|hooks-cli/index|flux-bits-report'
	grep -Eq "$markers" "$settings" 2>/dev/null || exit 0
	command -v jq >/dev/null 2>&1 || exit 0
	cleaned=$(jq --arg m "$markers" '
		.hooks |= (
			with_entries(.value |= map(select(
				any(.hooks[]?; (.command // "") | test($m)) | not
			)))
			| with_entries(select(.value | length > 0))
		)' "$settings") || exit 0
	# Write through the symlink, so settings.json stays a link into dotfiles.
	printf '%s\n' "$cleaned" >"$settings"
	exit 0
fi

# Skip reporting when Flux already owns the agent environment.
if [ "${1}" = bits ] && [ -n "${FLUX_AGENT_ENV:-}" ]; then
	exit 0
fi

case "${1}:$(uname -s)" in
relay:Darwin)
	# A native binary since Flux 0.1.45. It used to be a Node script run
	# through Electron, which now dies with a SyntaxError on the binary.
	relay="$mac_app/Contents/Resources/bin/flux-hooks-relay"
	[ -x "$relay" ] || exit 0
	exec "$relay" --source "$2"
	;;
relay:Linux)
	# Also a native binary since 0.1.45. Flux's per-agent flux-hooks-<agent>
	# wrappers from older installs still run it through node and die with a
	# SyntaxError, and upgrades don't rewrite them, so do what the new
	# wrappers do. The daemon listens on bridge.sock; no socket means no Flux.
	relay="$linux_bin/flux-hooks-relay"
	sock="$HOME/.flux/remote_run/bridge.sock"
	[ -x "$relay" ] && [ -S "$sock" ] || exit 0
	FLUX_SOCKET_PATH="$sock" exec "$relay" --source "$2"
	;;
bits:Darwin)
	[ -e "$mac_bin" ] || exit 0
	bits_agent="$2"
	[ "$bits_agent" = gemini ] && bits_agent=agy
	exec env "${tea_env[@]}" ELECTRON_RUN_AS_NODE=1 "$mac_bin" \
		"$mac_app/Contents/Resources/bin/flux-bits-report" "$bits_agent" "$3"
	;;
bits:Linux)
	[ -x "$linux_bin/flux-bits-report-wrapper" ] || exit 0
	bits_agent="$2"
	[ "$bits_agent" = gemini ] && bits_agent=agy
	exec env "${tea_env[@]}" "$linux_bin/flux-bits-report-wrapper" "$bits_agent" "$3"
	;;
esac
exit 0
